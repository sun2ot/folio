{
  "name": "folio-resume-studio",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "snapshot:github": "node --experimental-strip-types scripts/snapshot-github.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "check:tests": "tsc -p tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/noto-sans-sc": "^5.2.0",
    "@fontsource/noto-serif-sc": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "dompurify": "^3.2.7",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.0.0",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
